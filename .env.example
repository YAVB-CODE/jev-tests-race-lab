# Copia este archivo a .env y completa las keys para usar modo LIVE.
# Sin keys, la app funciona en modo SIMULADO (mock) para ambos carriles.
# El backend relee este archivo al guardarlo (no hace falta reiniciar, salvo para PORT).

# ── GPT (OpenAI) ──
OPENAI_API_KEY=
# Modelo por defecto del selector de la UI
OPENAI_MODEL=gpt-4.1-mini
# Precios USD por millón de tokens del modelo por defecto (los demás usan la tabla integrada)
OPENAI_PRICE_INPUT_PER_MTOK=0.40
OPENAI_PRICE_OUTPUT_PER_MTOK=1.60

# ── Jev (OpenCode Zen) ── https://opencode.ai/docs/zen
OPENCODE_API_KEY=
# Modelo por defecto del selector de la UI: jev-1.13-free (gratis, por defecto) o jev-1.13 (de pago)
JEV_MODEL=
# Precio de input por MTok de los modelos de pago (output gratis). Los modelos *-free siempre cuestan $0.
# JEV_PRICE_INPUT_PER_MTOK=0.042

PORT=8787

# ── Opcionales (valores por defecto entre paréntesis) ──
# OPENAI_REASONING_EFFORT=        (solo modelos de razonamiento gpt-5*/o*: minimal|low|medium|high)
# OPENAI_MAX_COMPLETION_TOKENS=   (4096 para modelos de razonamiento)
# OPENAI_TIMEOUT_MS=              (30000)
# OPENAI_MAX_RETRIES=             (1)
# OPENAI_BASE_URL=
# JEV_TIMEOUT_MS=                 (10000)
# JEV_MAX_RETRIES=                (1)
# OPENCODE_BASE_URL=              (https://opencode.ai/zen)
